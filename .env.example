# Phase 3 — copy to .env and adjust

# --- LLM: mock (dev) OR 9Router + Claude subscription ---
OPENAI_API_KEY=mock
# Real LLM via 9Router (run `npm i -g 9router && 9router` on host first):
# OPENAI_API_KEY=9router
# OPENAI_BASE_URL=http://host.docker.internal:20128/v1
# LLM_MODEL=claude-sonnet-4-20250514
# ^ model name = combo/provider configured in http://localhost:20128/dashboard

LLM_MODEL=gpt-4o-mini

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://chat:chat@localhost:5432/chat_agent
ORCHESTRATOR_URL=http://localhost:8000

# Celery — RabbitMQ broker (Phase 3)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Temporal (deep ReAct / research)
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=chat-deep

# Kafka audit (Redpanda)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_AUDIT_TOPIC=chat.audit

# Auth / multi-tenant
AUTH_ENABLED=false
JWT_SECRET=dev-secret-change-me
DEFAULT_TENANT_ID=default
RLS_ENABLED=true
